# Normalize text to LF in the repo and on checkout (the app is served as-is; the
# .sh launcher and the single-file HTML must stay LF on every platform).
* text=auto eol=lf

# Windows launcher keeps CRLF
*.bat text eol=crlf

# Binary assets — never touch line endings or diff as text
*.pdf   binary
*.xls   binary
*.xlsx  binary
*.docx  binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
